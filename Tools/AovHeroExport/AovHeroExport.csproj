<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AovHeroExport</AssemblyName>
    <RootNamespace>AovHeroExport</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AssetStudio\AssetStudio.csproj" />
    <ProjectReference Include="..\..\AssetStudioUtility\AssetStudioUtility.csproj" />
    <ProjectReference Include="..\..\AssetStudioFBXWrapper\AssetStudioFBXWrapper.csproj" />
  </ItemGroup>
  <!-- The FBX writer P/Invokes AssetStudioFBXNative and the decoder P/Invokes
       Texture2DDecoderNative; only Debug native builds exist in this tree, so
       copy whichever is available next to the tool. -->
  <Target Name="CopyNativeDeps" AfterTargets="AfterBuild">
    <ItemGroup>
      <FbxNative Include="$(MSBuildProjectDirectory)/../../AssetStudioFBXNative/bin/x64/Release/AssetStudioFBXNative.dll" />
      <FbxNative Include="$(MSBuildProjectDirectory)/../../AssetStudioFBXNative/bin/x64/Debug/AssetStudioFBXNative.dll" />
      <TexNative Include="$(MSBuildProjectDirectory)/../../Texture2DDecoderNative/bin/x64/Release/Texture2DDecoderNative.dll" />
      <TexNative Include="$(MSBuildProjectDirectory)/../../Texture2DDecoderNative/bin/x64/Debug/Texture2DDecoderNative.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FbxNative)" DestinationFolder="$(TargetDir)runtimes/win-x64/native" ContinueOnError="true" />
    <Copy SourceFiles="@(TexNative)" DestinationFolder="$(TargetDir)runtimes/win-x64/native" ContinueOnError="true" />
  </Target>
</Project>
